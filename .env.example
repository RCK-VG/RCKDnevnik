# Kopiraj ovu datoteku u ".env" i popuni vrijednosti prije pokretanja aplikacije.
# NIKAD ne commitaj stvarnu .env datoteku u git.

# Django tajni kljuc - generiraj novi za produkciju, npr.:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=promijeni-me-u-produkciji

# True samo za lokalni razvoj, u produkciji mora biti False
DEBUG=True

# Popis dopustenih domena/IP adresa odvojenih zarezom, npr: dnevnik.skola.hr,192.168.1.50
ALLOWED_HOSTS=localhost,127.0.0.1

# Ako je prazno, koristi se SQLite (data/db.sqlite3).
# Za PostgreSQL: postgres://KORISNIK:LOZINKA@HOST:5432/NAZIV_BAZE
DATABASE_URL=

# Vremenska zona i jezik
TIME_ZONE=Europe/Zagreb

# Sigurnosne postavke prijave
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_TIMEOUT_HOURS=8

# Postavi na True kada je aplikacija dostupna preko HTTPS-a (produkcija s Caddyjem)
SECURE_SSL_REDIRECT=False

# Samo za docker-compose.prod.yml (Caddy): tvoja domena, npr. dnevnik.skola.hr
# Ako nemas domenu, ostavi "localhost" - aplikacija ce i dalje raditi preko
# obicnog HTTP-a na IP adresi poslužitelja (Caddy bez domene ne moze izdati
# besplatni HTTPS certifikat).
DOMAIN=localhost

# Popis izvora kojima Django vjeruje za slanje formi (potrebno tek kad
# aplikacija radi na pravoj domeni s HTTPS-om), npr: https://dnevnik.skola.hr
CSRF_TRUSTED_ORIGINS=

# Koliko zadnjih dnevnih sigurnosnih kopija baze se cuva (starije se brisu)
BACKUP_KEEP=14
